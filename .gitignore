# Secrets — never commit
.env
.env.*
*.key
*.pem
secrets/
credentials*

# Private business content: processed only by local scripts / local models (see SECURITY.md)
private/

# Local runtime noise
logs/*.log
logs/*.jsonl
*.sqlite-journal
.DS_Store
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.idea/
.vscode/

# Derived or lock files (rebuildable from the canonical event log)
state/.write.lock
state/task-ledger/ledger.sqlite

# Claude Code local settings (personal)
.claude/settings.local.json

# Per-session Governor snapshots (may hold session names); reports/usage keeps the summaries
state/context-sessions/*.jsonl
state/loop-breaker/

# graphify code map (rebuild locally with: graphify update .)
graphify-out/
