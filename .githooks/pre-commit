#!/bin/sh
# Blocks commits that contain secret-like strings or touch private/. Enabled with:
#   git config core.hooksPath .githooks
here="$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -q '^private/'; then
  echo "BLOCKED: files under private/ must never be committed." >&2
  exit 1
fi
sh "$here/abos" secrets --staged || exit 1
exec sh "$here/abos" scan-memory --staged
